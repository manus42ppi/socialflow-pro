# SocialFlow Pro – Secrets (Vorlage)
# Kopiere diese Datei als .env und fülle die Werte ein.
# .env wird NIEMALS committed (steht in .gitignore).

# ── Anthropic (KI-Funktionen) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (Spark Voice Assistant TTS) ───────────────────────────
OPENAI_API_KEY=sk-...

# ── Optionale Dienste ─────────────────────────────────────────────
# Typst-Bridge-URL (nur nötig wenn pdf-lib nicht ausreicht)
# TYPST_BRIDGE_URL=https://deine-bridge.railway.app
